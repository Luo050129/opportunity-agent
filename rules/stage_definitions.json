{
  "version": "1.0",
  "stages": [
    {
      "code": "S5",
      "name": "赢单 / 签约",
      "condition": "已签合同或正式订单已确认。",
      "check": {
        "type": "keywords",
        "keywords": ["签合同", "签约", "已签", "合同已签", "合同生效", "合同正本", "正式订单", "订单已确认", "中标", "盖章", "下单了", "已下单", "首付款", "已回款"]
      },
      "guards": ["还没", "未签", "待签", "准备签", "打算签", "计划签", "正在走", "在走流程", "流程中", "没有签", "拟签", "走完流程", "签完再", "口头"],
      "evidence_required": true
    },
    {
      "code": "S4",
      "name": "决策审批",
      "condition": "明确进入内部立项、审批或供应商决策。",
      "check": {
        "type": "keywords",
        "keywords": ["立项", "内部审批", "审批流程", "上会", "评审会", "内部评审", "供应商决策", "决策流程", "走流程", "评标", "招标", "采购审批", "内部流程", "供应商准入", "审批中", "已审批"]
      },
      "entry_markers": ["已", "正在", "进入", "提交", "通过", "走到", "开始", "上会", "实施", "安排", "申请", "在走"],
      "guards": ["还没", "尚未", "未开始", "未进入", "没有进入", "计划", "打算", "预计", "准备", "将要", "拟", "走完流程", "等审批", "排队", "考虑"],
      "evidence_required": true
    },
    {
      "code": "S3",
      "name": "商务评估",
      "condition": "已讨论预算、报价、采购流程或合同条款之一，且需求仍有效。",
      "check": {
        "type": "keywords",
        "keywords": ["预算", "报价", "价格", "采购流程", "合同条款", "付款方式", "招标", "商务条款", "供应商框架", "年度供应商", "采购部门", "付款周期", "账期"]
      },
      "extra_check": {
        "type": "requirement_valid",
        "invalid_keywords": ["不需要了", "需求取消", "项目暂停", "暂停推进", "项目搁置", "不做了", "放弃了", "暂缓", "需求变了", "不采购了", "预算砍了", "需求失效"]
      },
      "evidence_required": true
    },
    {
      "code": "S2",
      "name": "方案验证",
      "condition": "客户明确同意演示、试用、技术交流或方案评估。",
      "check": {
        "type": "keywords_with_agreement",
        "keywords": ["演示", "试用", "技术交流", "方案评估", "方案讲解", "POC", "试点", "测试环境", "看方案", "评估方案"],
        "agreement": ["同意", "可以", "安排", "愿意", "答应", "确认", "约好", "参加", "组织", "定在", "定于", "接受", "一起看"]
      },
      "guards": ["没有同意", "还没定", "再考虑", "暂不", "下一步再说", "不打算"],
      "evidence_required": true
    },
    {
      "code": "S1",
      "name": "需求初探",
      "condition": "明确至少一个业务问题或使用场景。",
      "check": {
        "type": "field_status",
        "fields": ["需求", "核心场景"],
        "status": ["confirmed"]
      },
      "evidence_required": true
    },
    {
      "code": "S0",
      "name": "线索",
      "condition": "只有初步接触，无明确需求。",
      "check": {
        "type": "keywords",
        "keywords": ["聊", "见", "拜访", "电话", "微信", "初步", "介绍", "认识", "沟通", "加了", "约见", "接触"]
      },
      "evidence_required": false
    }
  ]
}
